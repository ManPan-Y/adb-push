{
  "_说明": "复制为 config.json 后生效。路径统一用正斜杠 '/'。",
  "devices": [
    { "address": "192.168.1.100:5555", "note": "示例设备" }
  ],
  "targets": [
    "/sdcard/Download/",
    "/sdcard/PC_GAME/",
    "/sdcard/Documents/"
  ],
  "defaults": {
    "direction": "push",
    "mode": "diff",
    "verify": "hash",
    "resume": true,
    "chunk_size_mb": 8,
    "jobs": 4,
    "parallel_threshold_mb": 64
  },
  "lan": {
    "_说明": "网卡直连：share_dir 是给安卓版/另一台电脑读写的目录，相对路径以程序目录为基准；token 非空时对端请求必须带同一个令牌",
    "port": 47820,
    "share_dir": "shared",
    "token": "",
    "auto_start": false,
    "name": ""
  },
  "jobs": [
    {
      "source": "D:/我的文件",
      "target": "/sdcard/Download/我的文件",
      "direction": "push",
      "mode": "diff",
      "verify": "hash"
    },
    {
      "source": "/sdcard/DCIM/Camera",
      "target": "D:/照片备份",
      "direction": "pull",
      "mode": "diff",
      "verify": "hash"
    }
  ]
}
