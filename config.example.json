{
  "_说明": "把本文件改名为 config.json 即可被工具自动读取。所有路径使用正斜杠 '/'。",
  "devices": [
    { "address": "192.168.1.100:5555", "note": "示例设备" }
  ],
  "targets": [
    "/sdcard/Download/",
    "/sdcard/PC_GAME/",
    "/sdcard/Documents/"
  ],
  "defaults": {
    "direction": "push",
    "mode": "diff",
    "verify": "hash",
    "resume": true,
    "chunk_size_mb": 8,
    "jobs": 4,
    "parallel_threshold_mb": 64
  },
  "jobs": [
    {
      "source": "D:/我的文件",
      "target": "/sdcard/Download/我的文件",
      "direction": "push",
      "mode": "diff",
      "verify": "hash"
    },
    {
      "source": "D:/GAME/ZenlessZoneZero Game",
      "target": "/sdcard/PC_GAME/",
      "direction": "push",
      "mode": "overwrite",
      "verify": "hash"
    },
    {
      "source": "/sdcard/DCIM/Camera",
      "target": "D:/照片备份",
      "direction": "pull",
      "mode": "diff",
      "verify": "hash"
    }
  ]
}
